# Diamante 0.3 — todo o nada 💎

mostrar "Hoy es", fecha_larga()
mostrar "Faltan", dias_hasta("31/12/2026"), "días para fin de año"
mostrar "Dentro de 300 días va a ser", sumar_dias(hoy(), 300)

# Matemática y listas
ventas = [50000, 8000, 50000, 5000, 120000]
mostrar "Total:", formato_plata(suma(ventas))
mostrar "Promedio:", formato_plata(promedio(ventas))
mostrar "La mayor venta:", formato_plata(maximo(ventas))
mostrar "Ordenadas:", ordenar(ventas, verdadero)
mostrar "¿7 es primo?", es_primo(7)
mostrar "El 21% de 50000 es", calcular_porcentaje(21, 50000)

# Texto
frase = "  diamante es el lenguaje más fácil del mundo  "
mostrar capitalizar(recortar(frase))
mostrar "Palabras:", contar_palabras(frase)
mostrar "Contraseña segura:", largo(generar_contraseña(16)), "caracteres"

# Fichas (datos con nombre)
cliente = {"nombre": "Veterinaria Huellitas", "ciudad": "Plottier", "pagó": verdadero}
mostrar cliente["nombre"], "de", cliente["ciudad"]
guardar datos cliente en "cliente.json"
leer datos de "cliente.json" y guardar en c
mostrar "Leído del archivo:", c["nombre"]

