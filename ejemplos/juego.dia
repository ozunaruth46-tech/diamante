# Adiviná el número 💎
secreto = aleatorio(1, 20)
intentos = 0
mostrar "Pensé un número del 1 al 20. ¡Adiviná!"

mientras verdadero:
    preguntar "Tu número:" y guardar en n
    sumar 1 a intentos
    si n es igual a secreto:
        mostrar "¡Ganaste en", intentos, "intentos! 🎉"
        salir
    o si n es menor que secreto:
        mostrar "Más alto ⬆️"
    sino:
        mostrar "Más bajo ⬇️"
